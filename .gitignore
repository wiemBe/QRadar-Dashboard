# Secrets — never commit
.env
deploy/mcp/config.json
*.pem
*.key
# Local secret material (QRadar service token, pinned CA). The whole directory
# is ignored rather than individual names, so a new secret dropped in here is
# safe by default instead of safe only if someone remembers to add a rule.
.secrets/
*.sec

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# Node / Next
node_modules/
.next/
frontend/out/
npm-debug.log*
# Generated by `next build` / `tsc --incremental`; regenerated on every build.
next-env.d.ts
*.tsbuildinfo

# Data / logs
logs/
*.log
postgres_data/

# Lab generator output. Run manifests and captured event files describe one
# operator's run and grow without bound; sanitized excerpts belong in
# docs/LAB-DEMO-RESULTS.md, and small fixtures live under backend/tests.
lab-runs/
*.summary.json

# Host-specific compose overlay (libvirt/macvlan layout of one machine).
docker-compose.override.yml
