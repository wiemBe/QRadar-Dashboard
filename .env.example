# =============================================================================
# qradar-observability — copy to .env and fill in. NEVER commit .env
# =============================================================================

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
DEBUG=true                        # MUST be false in production (enforced at startup)
# Explicit isolated-lab opt-in; rejected in production. See the lab guide for
# the exact accelerated intervals and thresholds.
LAB_MODE=false
LOG_LEVEL=INFO

# --- Secrets ----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-64-byte-urlsafe-token
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key
# Key rotation (optional). Active version for new writes:
ENCRYPTION_KEY_VERSION=1
# JSON map of ALL known key versions, for decrypting historical ciphertext during
# rotation, e.g. {"1":"<old-key>","2":"<new-key>"}. See app/security/crypto.py.
ENCRYPTION_KEYS_JSON=

# --- Database ---------------------------------------------------------------
POSTGRES_USER=qradar_obs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qradar_obs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- QRadar provider selection ----------------------------------------------
# mock | rest | mcp   (mock requires no QRadar instance — default for dev/tests)
QRADAR_PROVIDER=mock

# --- QRadar REST (deterministic collection + scheduled AQL) -----------------
# Preferred name. QRADAR_HOST is still accepted for compatibility.
QRADAR_BASE_URL=https://qradar.example.internal

# Bare console hostname — no scheme, no path. Only the `mcp` profile consumes
# it. Do not use QRADAR_HOST for this: the backend accepts that name as an alias
# for QRADAR_BASE_URL and rejects a value with no https:// scheme. Keep it set
# even under the mock provider, or `docker compose` warns on every invocation.
QRADAR_CONSOLE_FQDN=qradar.example.internal

# Read-only authorized service token. Never sent to the browser or an LLM.
#
# Prefer QRADAR_API_TOKEN_FILE over QRADAR_SEC_TOKEN: an environment variable is
# readable from /proc, appears in `docker inspect`, and is dumped by most crash
# reporters. A file can be mounted read-only with restrictive permissions. When
# both are set the file wins. The file is re-read on each provider build, so
# rotating it does not require a restart.
QRADAR_API_TOKEN_FILE=/run/secrets/qradar_sec_token
QRADAR_SEC_TOKEN=

# 20.0 still works on QRadar 7.6.0 but is flagged deprecated by the appliance;
# 7.6.0 offers up to 29.0. Per-instance values registered through the CLI
# override this.
QRADAR_API_VERSION=20.0

QRADAR_VERIFY_SSL=true
# Path to a CA bundle if QRadar uses an internal CA. Do NOT disable verification.
#
# The bundle must contain the *whole* trust path the appliance does not send.
# QRadar presents only its leaf certificate, so a bundle holding just the
# intermediate fails with "unable to get issuer certificate" — concatenate the
# root and the intermediate.
QRADAR_CA_BUNDLE=/run/secrets/qradar_ca.pem

# Tolerate an appliance certificate with no Authority Key Identifier.
#
# Python 3.13+ enables VERIFY_X509_STRICT by default, which enforces RFC 5280
# 4.2.1.1. QRadar's self-generated console certificate carries a Subject Key
# Identifier but no Authority Key Identifier, so strict mode rejects a chain
# the OpenSSL CLI accepts, surfacing as "Missing Authority Key Identifier".
#
# This relaxes a certificate *labelling* assertion only. Signature chain
# validation, expiry and hostname/IP-SAN matching all remain enforced. It is
# NOT equivalent to disabling verification, which this codebase refuses
# outright. Leave false unless your appliance certificate needs it; the real
# fix is to reissue that certificate with an AKI.
QRADAR_TLS_ALLOW_MISSING_AKI=false

# --- Ariel execution guardrails ---------------------------------------------
ARIEL_MAX_CONCURRENT_SEARCHES=3
ARIEL_GLOBAL_MAX_CONCURRENT_SEARCHES=6
ARIEL_DEFAULT_TIMEOUT_SECONDS=300
ARIEL_MAX_TIMEOUT_SECONDS=900
ARIEL_MAX_TIME_RANGE_HOURS=168
ARIEL_MAX_RESULT_ROWS=10000
ARIEL_POLL_INTERVAL_SECONDS=3
ARIEL_MAX_RETRIES=3
ARIEL_RETRY_BASE_SECONDS=2
ARIEL_RETRY_MAX_SECONDS=60

# --- Scheduled-search driver ------------------------------------------------
# Cap on searches dispatched per scheduler cycle, so a backlog can never turn
# one tick into an unbounded burst of Ariel searches.
SEARCH_MAX_DISPATCH_PER_CYCLE=10
# Consecutive failed runs before the search itself raises an alert. A detection
# that has silently stopped running produces no results and so no threshold
# breach — this is what surfaces it.
SEARCH_FAILURE_ALERT_AFTER=3

# --- Retention (TimescaleDB) — DISABLED by default (non-destructive) ---------
# Retention DROPS data. Leave disabled unless you explicitly want old chunks
# pruned. Applied by app.services.timescale, never by a migration.
#
# These are `int | None` and default to None (no policy). Leave them COMMENTED
# OUT to mean "unset" — an empty value is the string "", which fails int
# validation and refuses to start the backend. Uncomment with a day count to
# enable one.
RETENTION_ENABLED=false
#RETENTION_LOG_SOURCE_METRIC_DAYS=90
#RETENTION_SEARCH_RESULT_METRIC_DAYS=90
#RETENTION_RULE_METRIC_DAYS=90
#RETENTION_OFFENSE_SNAPSHOT_DAYS=180
#COMPRESSION_AFTER_DAYS=7

# --- Metric collection ------------------------------------------------------
COLLECTION_INTERVAL_SECONDS=300
COLLECTION_BATCH_SIZE=50
COLLECTION_MAX_BACKFILL_INTERVALS=12

# --- Phase 3 collection cadence ---------------------------------------------
# Celery Beat intervals for the offense/rule/coverage pipeline. Each is a
# deliberate default, not a fixed production cadence — tune per deployment.
# Ordering matters: inventory feeds health, health feeds coverage, so a
# dependent should not run more often than what it depends on.

# Full log source inventory pass. Log sources change rarely.
LOG_SOURCE_SYNC_INTERVAL_SECONDS=3600
# Incremental, watermark-driven; the most frequent of the four.
OFFENSE_COLLECTION_INTERVAL_SECONDS=300
# Operational checks/calculation over stored offense data.
OFFENSE_STALE_AFTER_SECONDS=900
OFFENSE_STALE_CHECK_INTERVAL_SECONDS=300
OFFENSE_AGGREGATE_INTERVAL_SECONDS=300
# Analytics rules *and* building blocks — one task covers both.
RULE_COLLECTION_INTERVAL_SECONDS=3600
# Inferred lower-bound rule metrics from stored offense contribution data.
RULE_METRIC_COLLECTION_INTERVAL_SECONDS=3600
RULE_METRIC_LOOKBACK_DAYS=30
RULE_METRIC_MAX_OFFENSES=10000
# Reads only stored data, so it can run more often than the sync feeding it.
RULE_HEALTH_EVALUATION_INTERVAL_SECONDS=1800
COVERAGE_EVALUATION_INTERVAL_SECONDS=3600

# Bounds on a single collection cycle, so a large backlog cannot turn one tick
# into an unbounded crawl.
OFFENSE_MAX_PAGES=20
OFFENSE_PAGE_SIZE=100
OFFENSE_MAX_BACKFILL_HOURS=168
RULE_MAX_PAGES=20

# --- Baselines --------------------------------------------------------------
BASELINE_MIN_SAMPLES=8
BASELINE_LOOKBACK_DAYS=28
BASELINE_MAD_FLOOR_RATIO=0.1

# --- Anomaly hysteresis -----------------------------------------------------
ANOMALY_OPEN_AFTER_INTERVALS=2
ANOMALY_RESOLVE_AFTER_INTERVALS=3
ANOMALY_DEVIATION_THRESHOLD=3.5

# --- Phase A volume guards ---------------------------------------------------
# Conjunctive with the robust z-score above, never a replacement for it. Each
# guard can only make the detector more conservative.
#
# The absolute-delta and minimum-volume pair exists to kill the classic false
# positive where 0.2 EPS becomes 0.4 EPS: a clean 2x ratio and a large robust
# z-score on a change of no operational significance.
ANOMALY_SPIKE_RATIO=2.0
ANOMALY_DROP_RATIO=0.5
ANOMALY_MIN_ABSOLUTE_DELTA_EVENTS=100
ANOMALY_MIN_BUCKET_EVENTS=50
# Empty buckets tolerated before NO_EVENTS fires.
ANOMALY_SILENCE_GRACE_BUCKETS=1
# Stamped on every anomaly, so a historical verdict can be read against the
# rules that produced it. Bump when detection semantics change.
ANOMALY_POLICY_VERSION=1

# --- Phase A explanation evidence --------------------------------------------
# Bounded aggregate Ariel queries that answer "what changed during the anomaly?".
# Read-only; no raw event or payload is ever retrieved or stored.
EXPLANATION_ENABLED=true
# Values retained per dimension; bounds both the Ariel result and the rows written.
EXPLANATION_TOP_VALUES=20
# Comparison window length as a multiple of the anomaly window.
EXPLANATION_BASELINE_WINDOW_MULTIPLE=3.0
# Hard ceiling on either window. Ariel cost scales with the window, and an
# unbounded investigation query can pin an appliance.
EXPLANATION_MAX_WINDOW_SECONDS=21600
EXPLANATION_QUERY_TIMEOUT_SECONDS=120
# Anomalies explained per task run: each costs two queries per dimension, so a
# backlog is drained over several runs rather than in one burst.
EXPLANATION_MAX_PER_RUN=5
EXPLANATION_COLLECTION_INTERVAL_SECONDS=300

# --- Notification delivery --------------------------------------------------
NOTIFY_MAX_RETRIES=5
NOTIFY_RETRY_BASE_SECONDS=2
NOTIFY_RETRY_MAX_SECONDS=300
NOTIFY_SEND_RECOVERY=true
NOTIFY_PER_CHANNEL_RATE=30/minute

# --- QRadar MCP (inventory only, GET-only, internal network) ----------------
MCP_ENABLED=false
MCP_BASE_URL=http://qradar-mcp:5000
MCP_TIMEOUT_SECONDS=60

# --- Authentication (OIDC-compatible abstraction) ---------------------------
AUTH_PROVIDER=local               # local | oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_SEARCH_EXECUTION=10/minute

# --- Notifications (all optional; leave blank to disable a channel) ---------
NOTIFY_TEAMS_WEBHOOK_URL=
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_GENERIC_WEBHOOK_URL=
NOTIFY_SYSLOG_HOST=
NOTIFY_SYSLOG_PORT=514
# Comma-separated; each recipient becomes its own route, so one bad mailbox
# does not park delivery for the others. Blank disables email routing entirely
# (the SMTP settings below are then unused).
NOTIFY_EMAIL_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=qradar-observability@example.internal
SMTP_USE_TLS=true

# --- LLM (interface only — MUST stay false until reviewed) ------------------
LLM_ENABLED=false
LLM_PROVIDER=null                 # null | anthropic | openai_compatible
LLM_API_KEY=
LLM_MODEL=claude-opus-4-8
# Hard safety rail: autonomous response actions are never implemented.
LLM_ALLOW_AUTONOMOUS_ACTIONS=false

# --- Frontend ---------------------------------------------------------------
# Used by Next.js Server Components inside Docker. Normally do not change it.
INTERNAL_API_BASE_URL=http://backend:8000/api/v1
# Used by browser-side actions.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
